{
  "welcomeFile": "/nubgatepassgateconsole/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/v4/gate-pass/(.*)$",
      "target": "/odata/v4/gate-pass/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/[^/]+/odata/v4/gate-pass/(.*)$",
      "target": "/odata/v4/gate-pass/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
