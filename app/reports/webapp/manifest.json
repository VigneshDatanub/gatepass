{
  "_version": "1.49.0",
  "sap.app": {
    "id": "nub.gatepass.reports",
    "type": "application",
    "title": "Gate Reports",
    "dataSources": {
      "mainService": {
        "uri": "odata/v4/gate-pass/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "applicationVersion": {
      "version": "1.0.0"
    },
    "description": "Visitor Gate Pass &amp; On-Site Register — NubTech Industries",
    "i18n": "i18n/i18n.properties",
    "crossNavigation": {
      "inbounds": {
        "gatepass-reports-display": {
          "semanticObject": "GatePass",
          "action": "reports",
          "title": "Gate Reports",
          "subTitle": "Visitor Logs & Compliance Reports",
          "icon": "sap-icon://manager-insight",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "gatepass"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "VisitorPassesList",
          "target": "VisitorPassesList"
        },
        {
          "pattern": "VisitorPasses({VisitorPassesKey}):?query:",
          "name": "VisitorPassesObjectPage",
          "target": "VisitorPassesObjectPage"
        }
      ],
      "targets": {
        "VisitorPassesList": {
          "type": "Component",
          "id": "VisitorPassesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/VisitorPasses",
              "initialLoad": "Enabled",
              "navigation": {
                "VisitorPasses": {
                  "detail": {
                    "route": "VisitorPassesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.SelectionFields": {
                  "annotationPath": "com.sap.vocabularies.UI.v1.SelectionFields#Reports"
                },
                "@com.sap.vocabularies.UI.v1.LineItem#OnSiteNow": {
                  "tableSettings": {
                    "type": "GridTable"
                  }
                },
                "@com.sap.vocabularies.UI.v1.LineItem#Overstay": {
                  "tableSettings": {
                    "type": "GridTable"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "onSiteNow",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#OnSiteNow"
                  },
                  {
                    "key": "overstay",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Overstay"
                  }
                ]
              }
            }
          }
        },
        "VisitorPassesObjectPage": {
          "type": "Component",
          "id": "VisitorPassesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/VisitorPasses"
            }
          }
        }
      }
    }
  }
}
