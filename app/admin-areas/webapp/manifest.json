{
  "_version": "1.49.0",
  "sap.app": {
    "id": "nub.gatepass.adminareas",
    "type": "application",
    "title": "Admin Console — Visit Areas",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/gate-pass/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "applicationVersion": {
      "version": "1.0.0"
    },
    "description": "Visitor Gate Pass &amp; On-Site Register — NubTech Industries",
    "i18n": "i18n/i18n.properties"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "VisitAreasList",
          "target": "VisitAreasList"
        },
        {
          "pattern": "VisitAreas({VisitAreasKey}):?query:",
          "name": "VisitAreasObjectPage",
          "target": "VisitAreasObjectPage"
        }
      ],
      "targets": {
        "VisitAreasList": {
          "type": "Component",
          "id": "VisitAreasList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/VisitAreas",
              "initialLoad": true,
              "navigation": {
                "VisitAreas": {
                  "detail": {
                    "route": "VisitAreasObjectPage"
                  }
                }
              }
            }
          }
        },
        "VisitAreasObjectPage": {
          "type": "Component",
          "id": "VisitAreasObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/VisitAreas"
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "gatepass"
  }
}
